{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sat-analysis.local/schemas/tasking_view.v1.json",
  "title": "Mechanically projected tasking view",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "analysis_request.v1.json#/$defs/task"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "revision",
    "content_hash",
    "tasks",
    "limitations"
  ],
  "additionalProperties": false
}
