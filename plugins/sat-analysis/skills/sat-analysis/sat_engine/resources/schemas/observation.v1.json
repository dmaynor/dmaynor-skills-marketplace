{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sat-analysis.local/schemas/observation.v1.json",
  "title": "Preserved source observation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "raw": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "parse_status": {
      "enum": [
        "parsed",
        "unparsed",
        "rejected"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "process": {
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "src_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "dst_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "src_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "dst_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "line_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "record_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_bytes_base64": {
      "type": [
        "string",
        "null"
      ],
      "format": "base64",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$(?![\\s\\S])"
    },
    "parse_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "parser": {
      "type": "string"
    },
    "address_mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependency_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "timestamp_semantics": {
      "type": "string"
    },
    "clock_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_uncertainty_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "timestamp_context": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fold": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "reliability": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "unknown"
      ],
      "default": "unknown"
    },
    "reliability_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "raw",
    "source",
    "parse_status"
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp_context": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fold": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
