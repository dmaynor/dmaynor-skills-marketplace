{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sat-analysis.local/schemas/hypothesis.v1.json",
  "title": "Analyst-authored hypothesis",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "initial_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "falsifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "posterior_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "description"
  ],
  "additionalProperties": false
}
